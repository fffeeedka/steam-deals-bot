# Токен от @BotFather
BOT_TOKEN=

# Регион магазина: us, ru, de, ... (влияет на валюту и доступность акций)
STEAM_CC=us

# Как часто проверять Steam, минуты
CHECK_INTERVAL_MINUTES=15

# Не больше N сообщений одному чату за один прогон
MAX_PER_RUN=5

# Сколько новых appid проверять за прогон (каждый = 1 запрос к Steam)
NEW_LOOKUP_LIMIT=120

# Куда писать базу и кэш
DATA_DIR=data
